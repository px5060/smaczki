# Skopiuj ten plik jako .env (plik .env nie trafia do repozytorium).
# Wszystko jest opcjonalne – bez klucza aplikacja bierze dane z football-data.co.uk.

# Klucz API-Football (dashboard.api-football.com). Darmowy plan nie obejmuje bieżących sezonów.
# API_FOOTBALL_KEY=twoj_klucz
# Tylko gdy klucz jest z RapidAPI:
# API_FOOTBALL_HOST=api-football-v1.p.rapidapi.com

# Powiadomienia na telefon przez aplikację ntfy (temat = trudna do zgadnięcia nazwa kanału)
# NTFY_TOPIC=smaczki-twoja-tajna-nazwa
